# Kindling environment
#
# Copy to `.env` (gitignored). `npm run dev` loads `.env` then `.env.local`
# via scripts/with-app-env.mjs — do not start Vite directly.
# These keys override Settings → Execution. Restart npm run dev after edits.
# Jira / GitHub PATs are Settings → Connect, not env.

# --- Logging ---
# Prints to the `npm run dev` terminal (and Settings → Execution → App log).
# silent | error | warn | info | debug
LOG_LEVEL=info

# --- Inherit / default agent ---
# cursor | claude | studio | cis | webllm
DEFAULT_AGENT=cursor

# --- Cursor / Claude CLI ---
# local | remote
CURSOR_TARGET=local
CLAUDE_TARGET=local
# Use cursor-agent, not `agent` — on this Mac `agent` is Grok.
CURSOR_COMMAND=cursor-agent -p --output-format text
CLAUDE_COMMAND=claude -p --output-format text
# Extra flags. Empty = code default (--trust -f for Cursor).
# CURSOR_EXTRA_ARGS=--trust -f
CLAUDE_EXTRA_ARGS=--permission-mode default
# Cursor --workspace / trust root. Empty = cwd of npm run dev.
# WORKSPACE=/Users/you/kindling
# Open Terminal.app and tee stdout into the App log (Mac). 1 on, 0 off.
RUN_IN_TERMINAL=1
# Full agent / auto (yolo, dontAsk, -f). Workday blocks this outside a dev container.
FULL_AGENT=0

# --- Timeouts ---
TIMEOUT_MS=120000
# Non-interactive stage wait (Agenda, Spec, Backlog, …). Default 5 min.
STAGE_TIMEOUT_MS=300000
# Notify: wait after slack-mcp success keywords before auto-harvest. 0 = immediate.
NOTIFY_MCP_SETTLE_MS=15000

# --- Fallbacks ---
# 0 = fail closed if the agent is missing. 1 = canned demo text.
DEMO_FALLBACKS=0

# --- WebLLM (in-browser WebGPU) ---
# WEBLLM_PROFILE=balanced
# WEBLLM_MODEL=

# --- Optional HTTP instead of CLI ---
# LOCAL_HTTP_URL=
# CURSOR_REMOTE_URL=
# CLAUDE_REMOTE_URL=

# --- GenAI Studio / CIS (feature key is your user id, not an API token) ---
# STUDIO_BASE_URL=https://your-genai-studio-host
# FEATURE_KEY=your.user.id
# PROMPT_ID=
# CIS_PROVIDER=aws
# CIS_MODEL=anthropic.claude-haiku-4-5-20251001-v1:0
# CIS_TASK_TYPE=aws-converse-v1
