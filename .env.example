# Kindling environment
#
# Copy to `.env` (gitignored). `npm run dev` loads `.env` then `.env.local`
# via scripts/with-app-env.mjs — do not start Vite directly.
# Every PIT_* key overrides Settings → Execution. Restart npm run dev after edits.
# Only keys the server actually reads are listed. Jira / GitHub PATs are
# Settings → Connect, not env.

# --- Logging ---
# Prints to the `npm run dev` terminal (and Settings → Execution → App log).
# silent | error | warn | info | debug
# info  = each execution call start / ok / fail
# debug = CLI path, args, cwd, truncated prompt (secrets redacted)
PIT_LOG_LEVEL=info

# --- Inherit / default agent ---
# cursor | claude | studio | cis | webllm
PIT_DEFAULT_AGENT=cursor

# --- Cursor / Claude CLI ---
# local | remote
PIT_CURSOR_TARGET=local
PIT_CLAUDE_TARGET=local
# Use cursor-agent, not `agent` — on this Mac `agent` is Grok.
PIT_CURSOR_COMMAND=cursor-agent -p --output-format text
PIT_CLAUDE_COMMAND=claude -p --output-format text
# Extra flags merged into interactive / Notify runs. Empty = code default (--trust -f for Cursor).
# PIT_CURSOR_EXTRA_ARGS=--trust -f
PIT_CLAUDE_EXTRA_ARGS=--permission-mode default
# Cursor --workspace / trust root. Empty = cwd of npm run dev.
# PIT_WORKSPACE=/Users/you/team-ai-harness
# Open Terminal.app and tee stdout into the App log (Mac). 1 on, 0 off.
PIT_RUN_IN_TERMINAL=1
# Full agent / auto (yolo, dontAsk, -f). Workday blocks this outside a dev container.
PIT_FULL_AGENT=0

# --- Timeouts ---
# Test / HTTP probe timeout (ms).
PIT_TIMEOUT_MS=120000
# Non-interactive stage wait (Agenda, Spec, Backlog, …). Default 5 min.
PIT_STAGE_TIMEOUT_MS=300000
# Notify: wait after slack-mcp success keywords before auto-harvest. 0 = immediate.
PIT_NOTIFY_MCP_SETTLE_MS=15000

# --- Fallbacks ---
# 0 = fail closed if the agent is missing. 1 = canned demo text.
PIT_DEMO_FALLBACKS=0

# --- WebLLM (in-browser WebGPU) ---
# Profile: fast | balanced | quality
# PIT_WEBLLM_PROFILE=balanced
# PIT_WEBLLM_MODEL=

# --- Optional HTTP instead of CLI ---
# PIT_LOCAL_HTTP_URL=
# PIT_CURSOR_REMOTE_URL=
# PIT_CLAUDE_REMOTE_URL=

# --- GenAI Studio / CIS (feature key is your user id, not an API token) ---
# PIT_STUDIO_BASE_URL=https://your-genai-studio-host
# PIT_FEATURE_KEY=your.user.id
# PIT_PROMPT_ID=
# PIT_CIS_PROVIDER=aws
# PIT_CIS_MODEL=anthropic.claude-haiku-4-5-20251001-v1:0
# PIT_CIS_TASK_TYPE=aws-converse-v1

# --- Token pricing (USD / million tokens). Overrides Settings → Execution → Token pricing. ---
# PIT_CHARS_PER_TOKEN=4
# PIT_CLAUDE_IN_USD_PER_MTOK=2
# PIT_CLAUDE_OUT_USD_PER_MTOK=10
# PIT_CURSOR_IN_USD_PER_MTOK=2
# PIT_CURSOR_OUT_USD_PER_MTOK=10
# PIT_STUDIO_IN_USD_PER_MTOK=2
# PIT_STUDIO_OUT_USD_PER_MTOK=10
# PIT_CIS_IN_USD_PER_MTOK=1
# PIT_CIS_OUT_USD_PER_MTOK=5
