# Copy to .env.local. Every PIT_* var overrides Team → Execution.

# Default agent for stages set to Inherit: cursor | claude | studio | cis
PIT_DEFAULT_AGENT=cursor

# Cursor / Claude: local CLI or remote HTTP
PIT_CURSOR_TARGET=local
PIT_CLAUDE_TARGET=local
PIT_CURSOR_COMMAND=agent -p --output-format text
PIT_CLAUDE_COMMAND=claude -p --output-format text
# PIT_LOCAL_HTTP_URL=http://127.0.0.1:11434/v1
# PIT_CURSOR_REMOTE_URL=https://agents.example/cursor
# PIT_CLAUDE_REMOTE_URL=https://agents.example/claude

# GenAI Studio / CIS (no API token — feature key is your user id)
# PIT_STUDIO_BASE_URL=https://your-genai-studio-host
# PIT_FEATURE_KEY=your.user.id
# PIT_PROMPT_ID=
# PIT_CIS_PROVIDER=aws
# PIT_CIS_MODEL=anthropic.claude-haiku-4-5-20251001-v1:0
# PIT_CIS_TASK_TYPE=aws-converse-v1

PIT_TIMEOUT_MS=120000
# 0 = fail closed if the agent is missing. 1 = canned demo text.
PIT_DEMO_FALLBACKS=0
